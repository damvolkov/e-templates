# Copy to .env — runtime config, every value optional (defaults live in the code).
# CI/CD publishing gates are NOT here: those are GitHub Actions variables
# (.github/ci.vars.example).
#
# APP__ENV=dev                    # dev | local | prod (logger rendering)
# APP__HOST=127.0.0.1
# APP__PORT=8000
# API__ALLOW_ORIGINS=["*"]        # JSON lists decode from env
# API__ALLOW_METHODS=["GET","POST","PATCH","DELETE"]
# CRYPTO__SECRET=                 # required: master root, HKDF-derives every key (Crypto.generate_keys())
# CRYPTO__ALG=HS256               # HS*/RS*/PS*/ES256/EdDSA
# OAUTH__CLIENT_ID=               # leave OAUTH__SERVER_METADATA_URL empty for the bare dev registry
# OAUTH__CLIENT_SECRET=
# OAUTH__SERVER_METADATA_URL=
# REDIS__URL=redis://localhost:6379/0
# DB__PATH=data/app.db
