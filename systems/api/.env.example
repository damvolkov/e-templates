# Copy to .env — runtime config, every value optional (defaults live in the code).
# core/ and ops/ are materialized from ../core: edit them there, never here.
#
# APP_ENV=dev                    # dev | local | prod (logger rendering)
# APP_HOST=127.0.0.1
# APP_PORT=8000
# SECRET=                        # required at runtime: crypto master root (Crypto.generate_keys())
# ALLOW_ORIGINS=["*"]            # JSON lists decode from env
# ALLOW_METHODS=["GET","POST","PATCH","DELETE"]
# REDIS_URL=redis://localhost:6379/0
# DB_PATH=data/app.db
# HTTP_BASE_URL=https://httpbin.org
# HTTP_TIMEOUT=10                # seconds, decoded to timedelta
# OAUTH_NAME=dev                 # leave SERVER_METADATA_URL empty for the bare dev registry
# CLIENT_ID=
# CLIENT_SECRET=
# SERVER_METADATA_URL=
